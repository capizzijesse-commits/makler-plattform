      const isPdf =
        metadata.contentType ===
        "application/pdf";

      const isImage =
        [
          "image/jpeg",
          "image/png",
          "image/webp",
        ].includes(
          metadata.contentType
        );

      if (isPdf) {
        registeredDocumentCount++;

        if (
          registeredDocumentCount >
          MAX_DOCUMENT_COUNT
        ) {
          return NextResponse.json(
            {
              success: false,
              error:
                "Bitte maximal 10 PDF-Dokumente hochladen.",
