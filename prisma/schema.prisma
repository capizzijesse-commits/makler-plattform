datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  password            String
  role                String   @default("user")
  plan                String   @default("free")
  freeGenerationsUsed Int      @default(0)
  freeGenerationLimit Int      @default(50)
  createdAt           DateTime @default(now())
}