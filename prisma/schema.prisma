datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String  @id @default(cuid())
  name                String
  email               String  @unique
  company             String?
  phone               String?
  password            String
  role                String  @default("user")
  plan                String  @default("free")
  freeGenerationsUsed Int     @default(0)
  freeGenerationLimit Int     @default(50)

  isFounder         Boolean @default(false)
  founderNumber     Int?    @unique
  founderPriceCents Int?

  stripeCustomerId          String?   @unique
  stripeSubscriptionId      String?   @unique
  stripeSubscriptionStatus  String?
  stripeSubscriptionPriceId String?
  stripeCurrentPeriodEnd    DateTime?
  stripeCancelAtPeriodEnd   Boolean   @default(false)

  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  passwordResetTokenHash   String?   @unique
  passwordResetExpires     DateTime?
  passwordResetRequestedAt DateTime?

  listings Listing[]
  sessions Session[]

  createdAt DateTime @default(now())
}

model Listing {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  location     String
  postalCode   String?
  propertyType String
  rooms        Float?
  livingArea   Float?
  price        Int?
  highlights   String?
  style        String?

  generatedVariants   String?
  socialVariants      String?
  imageAnalysis       String?
  locationDescription String?
  locationData        String?
  archivedAt          DateTime?

  paymentModel            String    @default("subscription")
  unlockStatus            String    @default("included")
  singleObjectPriceCents  Int       @default(990)
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?   @unique
  paidAt                  DateTime?

  images            ListingImage[]
  homeStagingImages HomeStagingImage[]
  finance           ListingFinance?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([userId, archivedAt])
  @@index([userId, unlockStatus])
}

model ListingFinance {
  id String @id @default(cuid())

  listingId String  @unique
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  marketingType String @default("sale")

  askingPrice    Int?
  minimumPrice   Int?
  commissionRate Float?

  financingEquity            Int?
  financingHardEquity        Int?
  financingAnnualGrossIncome Int?

  netRentMonthly         Int?
  additionalCostsMonthly Int?
  heatingCostsMonthly    Int?
  depositMonths          Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
}

model ListingImage {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  url        String
  storageKey String  @unique
  fileName   String?
  mimeType   String?
  sizeBytes  Int?

  position  Int     @default(0)
  isPrimary Boolean @default(false)

  analysis       String?
  analysisStatus String    @default("not_analyzed")
  analyzedAt     DateTime?

  homeStagingImages HomeStagingImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([listingId, position])
  @@index([listingId, isPrimary])
}

model HomeStagingImage {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  sourceImageId String
  sourceImage   ListingImage @relation(fields: [sourceImageId], references: [id], onDelete: Cascade)

  url        String
  storageKey String  @unique
  fileName   String?
  mimeType   String?
  sizeBytes  Int?

  roomType      String
  style         String
  aiModel       String
  promptVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([sourceImageId])
  @@index([listingId, createdAt])
}

model Session {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model StripeWebhookEvent {
  eventId         String   @id
  eventType       String
  stripeSessionId String?
  outcome         String
  livemode        Boolean
  stripeCreatedAt DateTime
  processedAt     DateTime @default(now())

  @@index([eventType])
  @@index([processedAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
