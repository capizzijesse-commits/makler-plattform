datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String  @id @default(cuid())
  name                String
  email               String  @unique
  googleSub           String? @unique
  company             String?
  phone               String?
  companyLogoUrl      String?
  companyLogoPathname String?
  password            String?
  role                String  @default("user")
  plan                String  @default("free")
  freeGenerationsUsed Int     @default(0)
  freeGenerationLimit Int     @default(50)

  isFounder         Boolean @default(false)
  founderNumber     Int?    @unique
  founderPriceCents Int?

  stripeCustomerId          String?   @unique
  stripeSubscriptionId      String?   @unique
  stripeSubscriptionStatus  String?
  stripeSubscriptionPriceId String?
  stripeCurrentPeriodEnd    DateTime?
  stripeCancelAtPeriodEnd   Boolean   @default(false)

  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  passwordResetTokenHash   String?   @unique
  passwordResetExpires     DateTime?
  passwordResetRequestedAt DateTime?

  listings                                                                Listing[]
  sessions                                                                Session[]
  valuations                                                              Valuation[]
  portalConnections                                                       PortalConnection[]
  MaklerChatBlock_MaklerChatBlock_blockedUserIdToUser                     MaklerChatBlock[]          @relation("MaklerChatBlock_blockedUserIdToUser")
  MaklerChatBlock_MaklerChatBlock_blockerUserIdToUser                     MaklerChatBlock[]          @relation("MaklerChatBlock_blockerUserIdToUser")
  MaklerChatBranding                                                      MaklerChatBranding?
  MaklerChatContactRequest_MaklerChatContactRequest_requesterUserIdToUser MaklerChatContactRequest[] @relation("MaklerChatContactRequest_requesterUserIdToUser")
  MaklerChatContactRequest_MaklerChatContactRequest_targetUserIdToUser    MaklerChatContactRequest[] @relation("MaklerChatContactRequest_targetUserIdToUser")

  createdAt DateTime @default(now())
}

model MaklerChatBlock {
  blockerUserId                            String
  blockedUserId                            String
  createdAt                                DateTime @default(now())
  User_MaklerChatBlock_blockedUserIdToUser User     @relation("MaklerChatBlock_blockedUserIdToUser", fields: [blockedUserId], references: [id], onDelete: Cascade)
  User_MaklerChatBlock_blockerUserIdToUser User     @relation("MaklerChatBlock_blockerUserIdToUser", fields: [blockerUserId], references: [id], onDelete: Cascade)

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

model MaklerChatBranding {
  userId     String   @id
  brandColor String   @default("#F59E0B")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MaklerChatContactRequest {
  id                                                  String                  @id
  requesterUserId                                     String
  targetUserId                                        String
  pairKey                                             String
  initialMessage                                      String?
  status                                              String                  @default("PENDING")
  countryCode                                         String                  @default("CH")
  languageCode                                        String                  @default("de")
  conversationId                                      String?
  createdAt                                           DateTime                @default(now())
  updatedAt                                           DateTime                @default(now())
  respondedAt                                         DateTime?
  MaklerChatConversation                              MaklerChatConversation? @relation(fields: [conversationId], references: [id])
  User_MaklerChatContactRequest_requesterUserIdToUser User                    @relation("MaklerChatContactRequest_requesterUserIdToUser", fields: [requesterUserId], references: [id], onDelete: Cascade)
  User_MaklerChatContactRequest_targetUserIdToUser    User                    @relation("MaklerChatContactRequest_targetUserIdToUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([requesterUserId, status, createdAt], map: "MaklerChatContactRequest_requester_status_createdAt_idx")
  @@index([targetUserId, status, createdAt], map: "MaklerChatContactRequest_target_status_createdAt_idx")
}

model MaklerChatConversation {
  id                       String                     @id
  kind                     String                     @default("AI")
  title                    String?
  market                   String                     @default("CH")
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now())
  visibility               String                     @default("PRIVATE")
  countryCode              String                     @default("CH")
  languageCode             String                     @default("de")
  directKey                String?                    @unique
  MaklerChatContactRequest MaklerChatContactRequest[]
  MaklerChatMessage        MaklerChatMessage[]
  MaklerChatParticipant    MaklerChatParticipant[]

  @@index([kind, updatedAt])
  @@index([visibility, countryCode, updatedAt], map: "MaklerChatConversation_visibility_countryCode_idx")
}

model MaklerChatMessage {
  id                     String                 @id
  conversationId         String
  senderUserId           String?
  senderType             String
  content                String
  createdAt              DateTime               @default(now())
  MaklerChatConversation MaklerChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model MaklerChatParticipant {
  conversationId         String
  userId                 String
  role                   String                 @default("MEMBER")
  joinedAt               DateTime               @default(now())
  lastReadAt             DateTime               @default(now())
  participantType        String                 @default("USER")
  MaklerChatConversation MaklerChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, conversationId])
  @@index([userId])
}

model PublicGuideQuestionLog {
  id        String   @id
  market    String
  pagePath  String?
  question  String
  answer    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([market, createdAt])
}

model PortalConnection {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Beispiel:
   * provider = "smg"
   * portal   = "immoscout24_ch"
   * portal   = "homegate_ch"
   */
  provider String
  portal   String

  /**
   * test | production
   */
  environment String @default("test")

  /**
   * Externe IDs dürfen gespeichert
   * werden. Keine Passwörter,
   * Client Secrets oder Access Tokens.
   */
  externalOwnerId String?
  externalUserId  String?

  /**
   * not_configured
   * configured
   * verified
   * error
   */
  status String @default("not_configured")

  /**
   * Woher Credentials kommen,
   * z.B. "env" für unseren Testzugang
   * oder später "vault".
   */
  credentialSource String?

  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, portal])
  @@index([userId])
  @@index([provider, portal])
}

model Listing {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectName String?
  street      String?
  location    String
  postalCode  String?
  latitude    Float?
  longitude   Float?
  market      String?

  countryCode  String?
  propertyType String
  rooms        Float?
  livingArea   Float?
  price        Int?
  highlights   String?
  style        String?

  generatedVariants   String?
  socialVariants      String?
  imageAnalysis       String?
  locationDescription String?
  locationData        String?
  archivedAt          DateTime?

  paymentModel            String    @default("subscription")
  unlockStatus            String    @default("included")
  singleObjectPriceCents  Int       @default(990)
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?   @unique
  paidAt                  DateTime?

  images            ListingImage[]
  homeStagingImages HomeStagingImage[]
  floorPlans        FloorPlan[]
  finance           ListingFinance?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  listingViewEvents ListingViewEvent[]

  @@index([userId])
  @@index([userId, archivedAt])
  @@index([userId, unlockStatus])
  @@index([countryCode])
}

model FloorPlan {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Geschoss / Reihenfolge
  floorLevel String
  sortOrder  Int    @default(0)

  // Originaldatei
  fileName   String?
  mimeType   String
  sizeBytes  Int
  url        String
  storageKey String  @unique

  // Massstab und Kalibrierung
  scaleLabel               String?
  scaleDenominator         Int?
  scaleSource              String?
  calibratedDistanceMeters Float?
  calibrationData          Json?

  // FÃ¼r die spÃ¤tere 3D-Konstruktion
  floorHeightMeters Float?
  analysis          Json?
  analysisVersion   String?
  geometry          Json?
  geometryVersion   String?

  // Workflow
  status String @default("uploaded")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([listingId, floorLevel])
  @@index([listingId, sortOrder])
}

model ListingViewEvent {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  visitorHash String

  source       String?
  referrerHost String?
  deviceType   String?

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([listingId, createdAt])
  @@index([listingId, visitorHash])
}

model ListingFinance {
  id String @id @default(cuid())

  listingId String  @unique
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  marketingType String @default("sale")

  askingPrice    Int?
  minimumPrice   Int?
  commissionRate Float?

  financingEquity            Int?
  financingHardEquity        Int?
  financingAnnualGrossIncome Int?

  netRentMonthly         Int?
  additionalCostsMonthly Int?
  heatingCostsMonthly    Int?
  depositMonths          Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
}

model ListingImage {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  url        String
  storageKey String  @unique
  fileName   String?
  mimeType   String?
  sizeBytes  Int?

  position  Int     @default(0)
  isPrimary Boolean @default(false)

  analysis       String?
  analysisStatus String    @default("not_analyzed")
  analyzedAt     DateTime?

  homeStagingImages HomeStagingImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([listingId, position])
  @@index([listingId, isPrimary])
}

model HomeStagingImage {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  sourceImageId String
  sourceImage   ListingImage @relation(fields: [sourceImageId], references: [id], onDelete: Cascade)

  url        String
  storageKey String  @unique
  fileName   String?
  mimeType   String?
  sizeBytes  Int?

  roomType      String
  style         String
  aiModel       String
  promptVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([sourceImageId])
  @@index([listingId, createdAt])
}

model Session {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Valuation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status String @default("draft")

  // BestÃ¤tigte Schweizer Adresse
  addressLabel String
  street       String?
  postalCode   String?
  city         String?

  latitude  Float
  longitude Float

  // Objekt
  propertyType String
  livingArea   Float
  landArea     Float?
  rooms        Float?

  buildingYear   Int
  renovationYear Int?

  condition String?
  standard  String?

  floorNumber Int?
  hasLift     Boolean?

  parking     String?
  outdoorArea String?
  view        String?

  // AVM / Marktdaten
  provider String?

  currency String @default("CHF")

  salePrice      Int?
  salePriceLower Int?
  salePriceUpper Int?
  pricePerSqm    Float?

  confidence    String?
  locationScore Float?

  valuedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, status])
}

model StripeWebhookEvent {
  eventId         String   @id
  eventType       String
  stripeSessionId String?
  outcome         String
  livemode        Boolean
  stripeCreatedAt DateTime
  processedAt     DateTime @default(now())

  @@index([eventType])
  @@index([processedAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
